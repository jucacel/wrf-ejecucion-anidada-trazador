# Copiar como rutas_linux.env y ajustar en la maquina Linux.

# Raiz local del caso.
export CASE_ROOT="$HOME/WRF_RUNS/caso_anidado_trazador"

# Instalaciones WPS/WRF.
export WPS_DIR="$HOME/Models/WPS"
export WRF_EM_REAL="$HOME/Models/WRF/test/em_real"

# Datos geograficos y meteorologicos.
export GEOG_DATA="$HOME/WRF_DATA/WPS_GEOG"
export MET_DATA_ROOT="$HOME/WRF_DATA/meteo"

# Datos y herramientas de emisiones. Mantener rutas reales fuera de Git.
export EMISSIONS_ROOT="$HOME/WRF_DATA/emisiones"
export MEGAN_DIR="$HOME/Models/MEGAN"
export MEGAN_DATA="$EMISSIONS_ROOT/megan"
export ANTHRO_DIR="$HOME/Models/ANTHRO_EMIS"
export ANTHRO_DATA="$EMISSIONS_ROOT/anthro"
export PREP_CHEM_DIR="$HOME/Models/PREP-CHEM-SRC"
export MOZBC_DIR="$HOME/Models/MOZBC"
export MOZART_DATA="$EMISSIONS_ROOT/mozbc"
export PYCHEMISS_DIR="$HOME/repos/PyChEmiss"
export AAS4WRF_DIR="$HOME/repos/AAS4WRF"
export LOCAL_EMISSIONS_FILE="$EMISSIONS_ROOT/local/emisiones_horarias.csv"
export PYCHEMISS_YML="$EMISSIONS_ROOT/local/pychemiss.yml"
export WRFCHEMI_SOURCE="pulse"
export WRFBIOS_FILE="$EMISSIONS_ROOT/megan/wrfbiochemi_d03"

# Descarga meteorologica.
# Valores soportados por commands/00_download_meteo.sh:
# manual, gfs_nomads, fnl_rda, era5_cds
export MET_DATA_SOURCE="manual"

# Parametros opcionales para GFS/NOMADS.
export GFS_DATE="20240901"
export GFS_CYCLE="00"
export GFS_FORECAST_HOURS="000 003 006 009 012"
export GFS_NOMADS_BASE_URL="https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl"
export GFS_LEVELS="lev_10_m_above_ground=on&lev_2_m_above_ground=on&lev_surface=on&lev_mean_sea_level=on&lev_1000_mb=on&lev_925_mb=on&lev_850_mb=on&lev_700_mb=on&lev_500_mb=on&lev_300_mb=on&lev_200_mb=on"
export GFS_VARIABLES="var_UGRD=on&var_VGRD=on&var_TMP=on&var_RH=on&var_HGT=on&var_PRES=on&var_PRMSL=on&var_SPFH=on&var_LAND=on"
# Para recorte espacial NOMADS, usar por ejemplo:
# export GFS_SUBREGION="leftlon=-80&rightlon=-70&toplat=10&bottomlat=0"

# Namelists genericos o privados mantenidos fuera de Git.
export NAMELIST_ROOT="$CASE_ROOT/namelists"
export NAMELIST_WPS="$NAMELIST_ROOT/namelist.wps"
export NAMELIST_REAL="$NAMELIST_ROOT/namelist.input.real"
export NAMELIST_NDOWN12="$NAMELIST_ROOT/namelist.input.ndown12"
export NAMELIST_NDOWN23="$NAMELIST_ROOT/namelist.input.ndown23"
export NAMELIST_D03_TRACER="$NAMELIST_ROOT/namelist.input.d03_tracer_4h"

# Directorios de corrida.
export RUN_WPS="$CASE_ROOT/wps"
export RUN_REAL="$CASE_ROOT/real"
export RUN_NDOWN12="$CASE_ROOT/ndown_d01_d02"
export RUN_NDOWN23="$CASE_ROOT/ndown_d02_d03"
export RUN_D03="$CASE_ROOT/run_d03_tracer_4h"
export OUTPUT_DIR="$CASE_ROOT/outputs"
export WRFCHEMI_FILE="$RUN_D03/wrfchemi_d03"

# Parametros del pulso.
export DOMAIN="d03"
export TRACER_NAME="CO_T"
export SOURCE_I="56"
export SOURCE_J="66"
export PULSE_START="2024-09-01_00:00:00"
export PULSE_HOURS="1"
export RUN_HOURS="4"
export EMISSIONS_INTERVAL_MIN="60"

# Postprocesamiento.
export POSTPROC_REPO="$HOME/repos/wrf_postprocesamiento_trazadores"
