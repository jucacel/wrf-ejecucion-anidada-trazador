# Copiar como rutas_linux.env y ajustar en la maquina Linux.

# Raiz local del caso.
export CASE_ROOT="$HOME/WRF_RUNS/caso_anidado_trazador"

# Instalaciones WPS/WRF.
export WPS_DIR="$HOME/Models/WPS"
export WRF_EM_REAL="$HOME/Models/WRF/test/em_real"

# Datos geograficos y meteorologicos.
export GEOG_DATA="$HOME/WRF_DATA/WPS_GEOG"
export MET_DATA_ROOT="$HOME/WRF_DATA/meteo"

# Namelists genericos o privados mantenidos fuera de Git.
export NAMELIST_ROOT="$CASE_ROOT/namelists"
export NAMELIST_WPS="$NAMELIST_ROOT/namelist.wps"
export NAMELIST_REAL="$NAMELIST_ROOT/namelist.input.real"
export NAMELIST_NDOWN12="$NAMELIST_ROOT/namelist.input.ndown12"
export NAMELIST_NDOWN23="$NAMELIST_ROOT/namelist.input.ndown23"
export NAMELIST_D03_TRACER="$NAMELIST_ROOT/namelist.input.d03_tracer_4h"

# Directorios de corrida.
export RUN_WPS="$CASE_ROOT/wps"
export RUN_REAL="$CASE_ROOT/real"
export RUN_NDOWN12="$CASE_ROOT/ndown_d01_d02"
export RUN_NDOWN23="$CASE_ROOT/ndown_d02_d03"
export RUN_D03="$CASE_ROOT/run_d03_tracer_4h"
export OUTPUT_DIR="$CASE_ROOT/outputs"

# Parametros del pulso.
export DOMAIN="d03"
export TRACER_NAME="CO_T"
export SOURCE_I="56"
export SOURCE_J="66"
export PULSE_START="2024-09-01_00:00:00"
export PULSE_HOURS="1"
export RUN_HOURS="4"
export EMISSIONS_INTERVAL_MIN="60"

# Postprocesamiento.
export POSTPROC_REPO="$HOME/repos/wrf_postprocesamiento_trazadores"
